rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /orgs/{orgId}/sites/{siteId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /orgs/{orgId}/rodadas/{rodadaId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /orgs/{orgId}/devices/{deviceId} {
      allow read, write: if signedIn() && request.auth.uid == deviceId;
    }

    match /orgs/{orgId}/inbox/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    match /orgs/{orgId}/users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
  }
}
